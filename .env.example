# MySQL
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=callisto
MYSQL_USER=callisto
MYSQL_PASSWORD=callisto_dev_password
MYSQL_PORT=3306

# api container reaches MySQL by service name "db" on the compose network
DATABASE_URL="mysql://callisto:callisto_dev_password@db:3306/callisto"

# Ports exposed to the host
API_PORT=3000
WEB_PORT=8080

# Callisto candidate tracker
TRACKER_BASE_URL="https://bipro2interface.sseku.com/api/candidate-tracker"
TRACKER_API_KEY="paste-your-personal-key-here"
